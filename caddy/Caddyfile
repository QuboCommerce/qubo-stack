# Peltier edge proxy
# One control plane (peltier-admin) fronting many storefronts.

admin.peltier.be {
	reverse_proxy peltier-admin:4000
}

hmfroid.be, www.hmfroid.be {
	reverse_proxy hm-froid:3000
}

