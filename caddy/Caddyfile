# Qubo edge proxy (customer instance)
# `qubo.<site domain>` → the panel (qubo-admin); every site domain → qubo-storefront.
# Phase 4 replaces these static blocks with on-demand TLS + an `ask` endpoint
# driven by verified site_domain rows.

qubo.hmfroid.be {
	reverse_proxy qubo-admin:4000
}

hmfroid.be, www.hmfroid.be {
	reverse_proxy qubo-storefront:3000
}

