[
  {
    "label": "dev: all apps",
    "command": "pnpm dev",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["peltier"]
  },
  {
    "label": "dev: peltier-admin (:4000)",
    "command": "pnpm --filter peltier-admin dev",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["peltier"]
  },
  {
    "label": "dev: hm-froid (:3000)",
    "command": "pnpm --filter hm-froid dev",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["peltier"]
  },
  {
    "label": "build: all",
    "command": "pnpm build",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["peltier"]
  },
  {
    "label": "lint: all",
    "command": "pnpm lint",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": ["peltier"]
  },
  {
    "label": "db: studio",
    "command": "pnpm db:studio",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["peltier", "db"]
  },
  {
    "label": "db: generate migration",
    "command": "pnpm db:generate",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": ["peltier", "db"]
  },
  {
    "label": "db: migrate",
    "command": "pnpm db:migrate",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": ["peltier", "db"]
  },
  {
    "label": "db: psql shell",
    "command": "docker exec -it supabase_db_react psql \"$(grep ^DATABASE_URL= .env | cut -d'\"' -f2 | sed 's/:54322/:5432/')\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "reveal": "always",
    "tags": ["peltier", "db"]
  },
  {
    "label": "db: backup dump",
    "command": "mkdir -p .private/backups && docker exec supabase_db_react pg_dump \"$(grep ^DATABASE_URL= .env | cut -d'\"' -f2 | sed 's/:54322/:5432/')\" --format=custom --no-owner --no-acl > .private/backups/peltier-$(date +%Y-%m-%d-%H%M).dump && ls -lh .private/backups",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": ["peltier", "db"]
  },
  {
    "label": "docker: up (legacy postgres only)",
    "command": "docker compose up -d peltier-postgres",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": ["peltier", "docker"]
  },
  {
    "label": "docker: down",
    "command": "docker compose down",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": ["peltier", "docker"]
  },
  {
    "label": "docker: logs",
    "command": "docker compose logs -f --tail=100",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": ["peltier", "docker"]
  },
  {
    "label": "setup: link root .env into apps",
    "command": "pnpm setup:env",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": ["peltier"]
  }
]
