# =============================================================================
# HM Froid - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Both apps read from .env at the monorepo root via dotenv.

# Database
DATABASE_URL="postgresql://hmf:hmf_secret@localhost:55433/hmfroid"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Panel URL (used by marketing site for cross-app references)
NEXT_PUBLIC_PANEL_URL="http://localhost:4000"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3000"
STOREFRONT_URL="http://localhost:3000"
STOREFRONT_STORE_SLUG="hm-froid"

# Stripe (payment processing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
HMF_SHIPPING_RATE_CENTS="0"
HMF_SHIPPING_LABEL="Livraison professionnelle"

# File Storage (Supabase Storage or S3-compatible)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
LEGACY_ASSET_ROOT="/absolute/path/to/.private/legacy-archive/YYYY-MM-DD/assets/products"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="HM Froid <noreply@hmfroid.be>"
ORDER_EMAIL_FROM="HM Froid <commandes@hmfroid.be>"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
