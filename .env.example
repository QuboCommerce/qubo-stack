# =============================================================================
# Peltier Stack - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Both apps read from .env at the monorepo root via dotenv.

# Database. Dev: shared Supabase CLI stack, isolated database "peltier"
# (see HANDOFF.md). POSTGRES_* only feed the legacy peltier-postgres container.
POSTGRES_USER="peltier"
POSTGRES_PASSWORD="peltier_secret"
POSTGRES_DB="peltier"
DATABASE_URL="postgresql://peltier:CHANGE_ME@127.0.0.1:54322/peltier"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Panel URL (used by marketing site for cross-app references)
NEXT_PUBLIC_PANEL_URL="http://localhost:4000"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3000"
STOREFRONT_URL="http://localhost:3000"
PUBLIC_ASSET_URL="http://localhost:3000"
STOREFRONT_SITE_SLUG="hm-froid"

# Stripe (payment processing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
HMF_SHIPPING_RATE_CENTS="0"
HMF_SHIPPING_LABEL="Livraison professionnelle"

# File Storage (Supabase Storage or S3-compatible)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
LEGACY_ASSET_ROOT="/absolute/path/to/.private/legacy-archive/YYYY-MM-DD/assets/products"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="HM Froid <noreply@hmfroid.be>"
ORDER_EMAIL_FROM="HM Froid <commandes@hmfroid.be>"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Peltier API (Elysia on Bun)
PELTIER_API_URL="http://localhost:3333"
PELTIER_TRUSTED_ORIGINS="http://localhost:3000,http://localhost:4000"
