# =============================================================================
# Qubo Stack - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Both apps read from .env at the monorepo root via dotenv.

# Database. Dev: shared Supabase CLI stack, isolated database "qubo"
# (see HANDOFF.md). POSTGRES_* only feed the legacy qubo-postgres container.
POSTGRES_USER="qubo"
POSTGRES_PASSWORD="qubo_secret"
POSTGRES_DB="qubo"
DATABASE_URL="postgresql://qubo:CHANGE_ME@127.0.0.1:54322/qubo"
# Connections per process (admin, api, storefront each hold one pool; idle ones close after 30 s).
# DATABASE_POOL_MAX=10

# Better Auth
# Signs Studio/site preview tokens and forwarded visitor IPs. Required by docker-compose (dev falls
# back to BETTER_AUTH_SECRET). Must match between API, admin and storefront.
# QUBO_PREVIEW_SECRET=
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Panel URL (used by marketing site for cross-app references)
NEXT_PUBLIC_PANEL_URL="http://localhost:4000"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3000"
STOREFRONT_URL="http://localhost:3000"
PUBLIC_ASSET_URL="http://localhost:3000"
STOREFRONT_SITE_SLUG="hm-froid"

# Stripe (payment processing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
CHECKOUT_SHIPPING_CENTS=""
CHECKOUT_SHIPPING_LABEL="Livraison professionnelle"

# File storage (media library, inbox attachments). Local disk by default: set STORAGE_DIR
# to a directory every app can read (compose mounts the `media` volume at /data/media).
# Set STORAGE_ENDPOINT to use any S3-compatible bucket instead (R2, Garage, OVH, Hetzner...).
STORAGE_DIR="/absolute/path/to/.private/media"
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="auto"
LEGACY_ASSET_ROOT="/absolute/path/to/.private/legacy-archive/YYYY-MM-DD/assets/products"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="HM Froid <noreply@hmfroid.be>"
ORDER_EMAIL_FROM="HM Froid <commandes@hmfroid.be>"
# Inbound e-mail (optional): the domain Resend receives on (`<id>.resend.app` or a verified
# domain with Resend's MX) and the signing secret of its `email.received` webhook, pointed at
# https://api.<base>/webhooks/resend. Each site receives at `<site-slug>@<domain>`.
EMAIL_INBOUND_DOMAIN=""
RESEND_WEBHOOK_SECRET=""

# Inbox AI (optional): providers and keys are set per organisation in Settings > AI.
# Set to "deny" on shared hosting so custom AI server URLs can't reach private networks.
# AI_PRIVATE_URLS=deny

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Qubo API (Elysia on Bun)
QUBO_API_URL="http://localhost:3333"
QUBO_TRUSTED_ORIGINS="http://localhost:3000,http://localhost:4000"

# Platform / hosts. Never hardcode a hostname in code; everything comes from here.
# Storefront for single-site installs when the host matches no domain.
STOREFRONT_DEFAULT_SITE=""
# Platform-provided site subdomains: <slug>.<PLATFORM_BASE_DOMAIN> (dev: dev.by-ali.dev).
PLATFORM_BASE_DOMAIN=""
# Panel host prefix: the admin lives at <ADMIN_SUBDOMAIN>.<site domain>.
ADMIN_SUBDOMAIN="qubo"

# Custom domains (Settings → Domains). The API checks DNS and serves the edge config.
# Public IP(s) customers point their A record at (comma list). Empty = resolve QUBO_PUBLIC_URL / BETTER_AUTH_URL.
QUBO_SERVER_IP=""
# Resolvers used for DNS checks (comma list). Default 1.1.1.1,8.8.8.8.
QUBO_DNS_SERVERS=""
# Guards GET /v1/edge/traefik (?token=). Use the same value in the edge's provider URL.
QUBO_EDGE_TOKEN=""
# Must match the edge: Traefik entrypoints, certificate resolver and upstream URLs.
QUBO_EDGE_ENTRYPOINT_HTTP="http"
QUBO_EDGE_ENTRYPOINT_HTTPS="https"
QUBO_EDGE_CERT_RESOLVER="letsencrypt"
QUBO_EDGE_ADMIN_URL="http://qubo-admin:4000"
QUBO_EDGE_STOREFRONT_URL="http://qubo-storefront:3000"
# 0 = do not route <slug>.<PLATFORM_BASE_DOMAIN> (when a wildcard router already covers it).
QUBO_EDGE_PLATFORM="1"
# Standalone edge only (docker compose --profile edge): Let's Encrypt account e-mail.
ACME_EMAIL=""
# Qubo Portal (licences, heartbeat, releases). Unset = pure self-host, Free limits.
PORTAL_URL=""
# Update channel: stable | beta | alpha.
QUBO_CHANNEL="stable"

# Qubo Portal link (optional; the instance is fully usable without it).
# Link from Settings → Qubo Portal. Only the >1-site-per-instance gate depends on a linked Growth account.
# PORTAL_URL=https://portal.qubo.by-ali.dev   # default shown in the link form
# PORTAL_API_URL=                             # derived from PORTAL_URL (portal. → api.portal.) unless set
# QUBO_VERSION=0.0.0                          # reported in heartbeats; set by the release pipeline
# QUBO_CHANNEL=stable                         # stable | beta
