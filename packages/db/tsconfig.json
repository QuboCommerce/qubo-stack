{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@qubo/db/*": ["./*"]
    }
  },
  "include": ["schema/**/*.ts", "src/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
