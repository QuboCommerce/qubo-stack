{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"], "exclude": ["src/**/*.test.ts"]
}
